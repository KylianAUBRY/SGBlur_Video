# Copy to `.env` and adjust. Every variable is documented in
# docs/reference/configuration.md (generated from src/sgblur_video/config.py).

# API_NAME=SGBlur-Video            # never change after deployment
# MODEL_NAME=                      # empty: automatic selection (yolo26 family)
# DEVICE=auto                      # auto | cpu | mps | cuda | cuda:N
# DETECT_URL=                      # empty: detection runs in the worker
# CONF_BLUR=0.15                   # lower = more blurring (privacy-first)
# BLUR_METHOD=pixelate_blur        # pixelate_blur | gaussian_strong | solid
# DATA_DIR=data
# RESULT_TTL_MINUTES=60
# KEEP_SECRET_KEY=                 # empty disables keep=1
